CREATE OR REPLACE PROCEDURE LOCALDB.UT_FUND_ACCOUNT_STATS
(
corpId IN VARCHAR2,
  accountNo IN VARCHAR2,
  CURSOR OUT SYS_REFCURSOR
) AS
BEGIN
OPEN CURSOR FOR
  		SELECT COUNT(tadu.id) as totNoOfFunds,
  		sum(tadu.TOTAL_VALUE) AS consTotEstMarketValue
		FROM TBL_ACCT ta, TBL_CORP tc, TBL_CORP_ACCTS tca, TBL_ACCT_DTL_UT tadu
		WHERE tadu.CIF_NUMBER = tc.CIF_NO
		AND ta.ID = tca.ACCT_ID
		AND ta.ACCT_NO = tadu.ACCOUNT_NO
		AND tc.id  = tca.CORP_ID
		AND ta.PROD_CD = 'INVESTMENT'
		AND tc.CORP_ID = corpId
		AND tadu.ACCOUNT_NO = accountNo ;

END UT_FUND_ACCOUNT_STATS;